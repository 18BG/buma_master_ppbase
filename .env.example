# PPBase / PostgreSQL foundation configuration
PPBASE_DATABASE_URL=postgresql+asyncpg://ppbase:ppbase@localhost:55434/buma_master_ppbase
POSTGRES_DB=buma_master_ppbase
POSTGRES_USER=ppbase
POSTGRES_PASSWORD=ppbase
POSTGRES_PORT=55434
PPBASE_HOST=127.0.0.1
PPBASE_PORT=8097
PPBASE_DATA_DIR=pb_data
PPBASE_MIGRATIONS_DIR=pb_migrations

# Optional: point the verification scripts and Makefile at another database.
# PPBASE_DATABASE_URL=postgresql+asyncpg://ppbase:ppbase@localhost:55434/buma_master_ppbase_manual_test

# Keep internal jobs disabled until the source inventory confirms an active job.
BUMA_MASTER_ENABLE_INTERNAL_JOBS=false
